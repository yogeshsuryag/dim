#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# Match Omarchy's PluginRegistry and native plugin commands (not XDG_CONFIG_HOME).
PLUGIN_ROOT="$HOME/.config/omarchy/plugins"
SHELL_CONFIG="$HOME/.config/omarchy/shell.json"
PLUGIN_BACKUP_ROOT="$HOME/.config/omarchy/plugin-backups"
REPLACE=false
STAGED=()
FILES_CHANGED=false

usage() {
  echo "Usage: ./install-companions [--replace]"
  echo "Install and enable oma.dim, oma.display, and oma.indicators."
}

case "${1:-}" in
  "") ;;
  --replace) REPLACE=true ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 64 ;;
esac
[[ $# -le 1 ]] || { usage >&2; exit 64; }

for command in omarchy omarchy-shell jq diff; do
  command -v "$command" >/dev/null || { echo "Missing required command: $command" >&2; exit 127; }
done

cleanup() {
  local stage
  for stage in "${STAGED[@]}"; do
    [[ ! -e "$stage" ]] || rm -rf -- "$stage"
  done
}
trap cleanup EXIT

ids=(oma.display oma.indicators)
mkdir -p -- "$PLUGIN_ROOT"

# Validate all sources and reject conflicts before installing or enabling anything.
omarchy plugin validate "$SCRIPT_DIR"
for id in "${ids[@]}"; do
  source_dir="$SCRIPT_DIR/companions/$id"
  [[ -d "$source_dir" ]] || { echo "Missing companion source: $source_dir" >&2; exit 1; }
  omarchy plugin validate "$source_dir"
  source_id=$(jq -er '.id' "$source_dir/manifest.json")
  [[ "$source_id" == "$id" ]] || { echo "Expected plugin id $id, found $source_id" >&2; exit 1; }
  target="$PLUGIN_ROOT/$id"
  [[ ! -L "$target" ]] || { echo "Refusing symlink target: $target" >&2; exit 1; }
  if [[ -e "$target" ]] && ! diff -qr -- "$source_dir" "$target" >/dev/null; then
    $REPLACE || { echo "Different plugin already exists at $target (pass --replace to back it up and replace it)." >&2; exit 1; }
  fi
done

# Stage and validate every replacement before moving any installed plugin.
for id in "${ids[@]}"; do
  source_dir="$SCRIPT_DIR/companions/$id"
  target="$PLUGIN_ROOT/$id"
  if [[ -d "$target" ]] && diff -qr -- "$source_dir" "$target" >/dev/null; then
    continue
  fi
  stage=$(mktemp -d "$PLUGIN_ROOT/.${id}.stage.XXXXXX")
  STAGED+=("$stage")
  cp -a -- "$source_dir/." "$stage/"
  omarchy plugin validate "$stage"
done

for id in "${ids[@]}"; do
  source_dir="$SCRIPT_DIR/companions/$id"
  target="$PLUGIN_ROOT/$id"
  [[ -d "$target" ]] && diff -qr -- "$source_dir" "$target" >/dev/null && continue
  stage=${STAGED[0]}
  STAGED=("${STAGED[@]:1}")
  if [[ -e "$target" ]]; then
    mkdir -p -- "$PLUGIN_BACKUP_ROOT"
    backup="$PLUGIN_BACKUP_ROOT/${id}.backup.$(date +%Y%m%d%H%M%S).$$"
    [[ ! -e "$backup" ]] || { echo "Backup already exists: $backup" >&2; exit 1; }
    mv -- "$target" "$backup"
    if ! mv -- "$stage" "$target"; then
      mv -- "$backup" "$target"
      exit 1
    fi
    echo "Replaced $id (backup: $backup)"
  else
    mv -- "$stage" "$target"
    echo "Installed $id"
  fi
  FILES_CHANGED=true
done

$FILES_CHANGED && omarchy-shell shell rescanPlugins >/dev/null
# rescanPlugins returns before the registry's subprocess has read the new files.
# Retry the rescan too: an earlier in-flight scan can ignore the first request.
discovered=false
discovery_deadline=$((SECONDS + 5))
for ((attempt = 0; SECONDS < discovery_deadline; attempt++)); do
  installed_plugins=$(omarchy plugin list --json)
  if jq -e 'map(.id) as $found | ["oma.dim", "oma.display", "oma.indicators"]
    | all(. as $id | $found | index($id) != null)' <<<"$installed_plugins" >/dev/null; then
    discovered=true
    break
  fi
  sleep 0.05
  if (( attempt % 10 == 9 )); then omarchy-shell shell rescanPlugins >/dev/null; fi
done
$discovered || {
  echo "Dim files were installed in $PLUGIN_ROOT, but Omarchy did not discover all three plugins within 5 seconds. No activation changes were made. Check the shell logs and rerun this installer." >&2
  exit 1
}

NEEDS_ENABLE=()
LEGACY_ENABLED=()
mapfile -t LEGACY_ENABLED < <(jq -r '.[] | select(.enabled == true)
  | select(.id == "jarvis.dim" or .id == "jarvis.screendim"
    or .id == "jarvis.display" or .id == "jarvis.indicators") | .id' <<<"$installed_plugins")
for id in oma.dim oma.indicators oma.display; do
  if ! jq -e --arg id "$id" 'any(.[]; .id == $id and .enabled == true)' <<<"$installed_plugins" >/dev/null; then
    NEEDS_ENABLE+=("$id")
  fi
done

if (( ${#NEEDS_ENABLE[@]} > 0 || ${#LEGACY_ENABLED[@]} > 0 )) && [[ -f "$SHELL_CONFIG" ]]; then
  backup="$SHELL_CONFIG.backup.$(date +%Y%m%d%H%M%S).$$"
  [[ ! -e "$backup" ]] || { echo "Config backup already exists: $backup" >&2; exit 1; }
  cp -a -- "$SHELL_CONFIG" "$backup"
  echo "Saved current shell config to $backup"
fi

for id in "${LEGACY_ENABLED[@]}"; do
  omarchy plugin disable "$id"
done
installed_plugins=$(omarchy plugin list --json)
for id in "${NEEDS_ENABLE[@]}"; do
  if [[ $id == oma.indicators ]] && jq -e 'any(.[]; .id == "omarchy.indicators" and .enabled == true)' <<<"$installed_plugins" >/dev/null; then
    omarchy plugin enable "$id" --before omarchy.indicators
  else
    omarchy plugin enable "$id"
  fi
done

installed_plugins=$(omarchy plugin list --json)
for id in oma.dim oma.indicators oma.display; do
  jq -e --arg id "$id" 'any(.[]; .id == $id and .enabled == true)' <<<"$installed_plugins" >/dev/null || {
    echo "Omarchy did not enable '$id'." >&2
    exit 1
  }
done
echo "Installed and enabled: oma.dim, oma.display, oma.indicators."
