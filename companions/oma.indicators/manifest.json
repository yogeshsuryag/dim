{
  "schemaVersion": 1,
  "id": "oma.indicators",
  "name": "Screen Dim Indicator",
  "version": "1.0.1",
  "author": "Dim (adapted from Omarchy)",
  "description": "A standalone bar control for the Dim overlay",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Indicators.qml"
  },
  "barWidget": {
    "displayName": "Screen Dim",
    "description": "Manual state indicators",
    "category": "Status",
    "allowMultiple": true,
    "schema": [
      {
        "key": "items",
        "type": "multiselect",
        "label": "Indicators",
        "description": "Choose which indicators this widget instance should show. Leave empty to show all indicators.",
        "noSelectionText": "All indicators",
        "placeholderText": "Search indicators...",
        "emptyText": "No indicators",
        "options": [
          {
            "value": "ScreenDim",
            "label": "Screen dim",
            "description": "Toggle the screen dim overlay"
          }
        ]
      },
      {
        "key": "alwaysShow",
        "type": "boolean",
        "label": "Always Show",
        "description": "Show inactive indicators without waiting for hover.",
        "defaultValue": true
      }
    ],
    "defaultSection": "right"
  },
  "license": "MIT"
}
